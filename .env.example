# Copy to .env (or export) for local runs without Docker Compose.
DATABASE_URL=postgresql+psycopg2://radio:radio@localhost:5432/radio
# Non-negative guard band; same unit as the frequency numbers (examples use MHz).
# INITIAL VALUE ONLY: seeded into a brand-new database. The live setting is
# stored in the database and changed online via POST /api/config/guard-band;
# restarts never overwrite it.
GUARD_BAND=2.0
APP_HOST=0.0.0.0
APP_PORT=8000
